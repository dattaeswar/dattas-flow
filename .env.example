NVIDIA_API_KEY=your-nvidia-nim-api-key-here
NIM_MODEL=openai/gpt-oss-120b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: sign up free at https://tavily.com for live web-search grounding.
# Leave blank to skip search.
TAVILY_API_KEY=

# Speech-to-text (NVIDIA Riva Parakeet, multilingual ASR). Uses the same
# NVIDIA_API_KEY above. Defaults below are the public multilingual model —
# only override if you want a different Riva ASR model/function.
RIVA_ASR_URI=grpc.nvcf.nvidia.com:443
RIVA_ASR_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610
